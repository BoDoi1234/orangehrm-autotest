<?xml version="1.0" encoding="UTF-8"?>
<Configuration xmlns=""
               xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="">

    <Appenders>
        <Console name="CONSOLE">
            <PatternLayout pattern="[%d] [%t] [%p] [%c] - %m%n" charset="UTF-8"/>
        </Console>

        <File name="MAIN" fileName="logs/main.log" append="false">
            <PatternLayout pattern="[%d] [%t] [%p] [%c] - %m%n" charset="UTF-8"/>
        </File>
    </Appenders>
    <Loggers>
        <Root level="TRACE">
            <AppenderRef ref="CONSOLE"/>
            <AppenderRef ref="MAIN"/>
        </Root>

        <!--  name: condition to call appender => package name -->
        <!--        <Logger name="vn.vti" level="TRACE">-->
        <!--            <AppenderRef ref="DEBUG_LOG"/>-->
        <!--        </Logger>-->
    </Loggers>
</Configuration>